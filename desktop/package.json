{
  "name": "lucode-desktop",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:renderer:lite": "node ./scripts/build-renderer-lite.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "smoke:electron": "npm run build:stable && node ./scripts/electron-smoke.mjs",
    "build:stable": "npm run typecheck && (vite build || npm run build:renderer:lite) && npm run build:electron"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
